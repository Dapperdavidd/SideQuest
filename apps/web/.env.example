NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public origin used in share links and QR codes (short links live at /q/CODE).
NEXT_PUBLIC_SHARE_ORIGIN=https://sdqst.app

# Universal links / App Links for /q and /g so links open the app when installed.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=app.sidequest.mobile
ANDROID_PACKAGE=app.sidequest.mobile
ANDROID_CERT_SHA256=

# Apple Maps (MapKit JS). Create a Maps ID + key in the Apple Developer portal.
# Without these the map falls back to the illustrated map.
MAPKIT_TEAM_ID=
MAPKIT_KEY_ID=
# Contents of the .p8 key. Newlines may be written as \n.
MAPKIT_PRIVATE_KEY=
# Optional: restrict tokens to one origin, e.g. https://sdqst.app
MAPKIT_ALLOWED_ORIGIN=
