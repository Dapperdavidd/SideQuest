# Web
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
MOBILE_AUTH_REDIRECT_URL=app.sidequest://login-callback/

# API
API_HOST=127.0.0.1
API_PORT=8080
DATABASE_URL=postgres://sidequest:sidequest@localhost:5432/sidequest
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Nimiq integration defaults to testnet during development
NIMIQ_NETWORK=testnet
NIMIQ_RPC_URL=https://your-history-enabled-nimiq-rpc.example
NIMIQ_TREASURY_ADDRESS=NQ00_REPLACE_WITH_DEDICATED_ESCROW_ADDRESS
NIMIQ_MIN_CONFIRMATIONS=2
NIMIQ_QUOTE_PROVIDER_URL=https://your-approved-price-oracle.example
PAYOUT_SIGNER_URL=https://your-isolated-payout-signer.example
PAYOUT_SIGNER_TOKEN=replace_with_server_only_signer_token
USDT_EVM_CHAIN_ID=80002
POLYGON_RPC_URL=https://your-polygon-amoy-rpc.example
USDT_CONTRACT_ADDRESS=0xREPLACE_WITH_SUPPORTED_TESTNET_TOKEN
